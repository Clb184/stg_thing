@main:
	;musicload
	;musicplay
	;call camera
	halt

@camera:
	; Setup camera pos and rot
	setm 20, 0.0
	setm 21, -150.0
	setm 22, 260.0

	setm 24, -3.2288
	setm 24, -3.14159
	setm 25, 0.0 ;-0.1919
	setm 26, -0.9599

	; Move and lock between 256.0f
	loadm r1, 21
	greatfc 106.0
	jmpt redo
	;addpos 0.0, 80.0, 0.0
	nop
	jmp loop
redo:
	loadm r1, 21
	subfc 256.0
	storem 21
	jmp loop
